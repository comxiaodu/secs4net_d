<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="TraePrimary" Color="#007acc" />
    <SolidColorBrush x:Key="TraePrimaryHover" Color="#0066b3" />
    <SolidColorBrush x:Key="TraeSecondary" Color="#00d4aa" />
    <SolidColorBrush x:Key="TraeAccent" Color="#ff9500" />
    <SolidColorBrush x:Key="TraeError" Color="#ff3b30" />
    <SolidColorBrush x:Key="TraeSuccess" Color="#34c759" />
    <SolidColorBrush x:Key="TraeWarning" Color="#ffcc00" />
    
    <SolidColorBrush x:Key="TraeBackground" Color="#ffffff" />
    <SolidColorBrush x:Key="TraeSurface" Color="#ffffff" />
    <SolidColorBrush x:Key="TraeSurfaceLight" Color="#f0f0f0" />
    <SolidColorBrush x:Key="TraeBorder" Color="#e0e0e0" />
    <SolidColorBrush x:Key="TraeTextPrimary" Color="#000000" />
    <SolidColorBrush x:Key="TraeTextSecondary" Color="#333333" />
    <SolidColorBrush x:Key="TraeTextDisabled" Color="#888888" />

    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource TraeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TraeTextPrimary}" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{StaticResource TraeTextSecondary}" FontSize="12" FontWeight="SemiBold" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource TraePrimary}" />
        <Setter Property="Background" Value="{StaticResource TraePrimary}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter Property="Background" Value="{StaticResource TraePrimaryHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Background" Value="#f0f0f0" />
                <Setter Property="BorderBrush" Value="#e0e0e0" />
                <Setter Property="Foreground" Value="{StaticResource TraeTextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource TraeTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource TraeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="true">
                <Setter Property="BorderBrush" Value="{StaticResource TraePrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Foreground" Value="{StaticResource TraeTextSecondary}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Margin" Value="4" />
        <Setter Property="Foreground" Value="{StaticResource TraeTextPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="4" />
        <Setter Property="Foreground" Value="{StaticResource TraeTextPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource TraeTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource TraeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{StaticResource TraeTextPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="true">
                <Setter Property="Background" Value="{StaticResource TraePrimary}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter Property="Background" Value="{StaticResource TraeSurfaceLight}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource TraeBackground}" />
        <Setter Property="Foreground" Value="{StaticResource TraeTextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource TraeTextSecondary}" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="true">
                <Setter Property="Background" Value="{StaticResource TraeBackground}" />
                <Setter Property="Foreground" Value="{StaticResource TraePrimary}" />
                <Setter Property="BorderThickness" Value="0,0,0,2" />
                <Setter Property="BorderBrush" Value="{StaticResource TraePrimary}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter Property="Background" Value="{StaticResource TraeSurfaceLight}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource TraeTextPrimary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource TraeBorder}" />
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource TraeTextSecondary}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter Property="Background" Value="{StaticResource TraePrimary}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource TraeSurfaceLight}" />
        <Setter Property="Foreground" Value="{StaticResource TraePrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="8" />
    </Style>

    <Style TargetType="RichTextBox">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource TraeTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource TraeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource TraeSurfaceLight}" />
        <Setter Property="Foreground" Value="{StaticResource TraeTextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource TraeBorder}" />
        <Setter Property="Cursor" Value="SizeWE" />
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource TraeTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource TraeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</ResourceDictionary>