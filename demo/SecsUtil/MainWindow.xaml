<Window x:Class="SecsUtil.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SecsUtil.Controls"
        mc:Ignorable="d"
        Title="SecsUtil - SECS-II Communication Tool" Height="900" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource TraeBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Height="32" Background="{StaticResource TraeSurface}">
            <MenuItem Header="_File">
                <MenuItem Header="_Save Log" Click="SaveLog_Click" />
                <MenuItem Header="_Clear Log" Click="ClearLog_Click" />
                <Separator />
                <MenuItem Header="_Import Templates" Click="ImportTemplates_Click" />
                <MenuItem Header="_Export Templates" Click="ExportTemplates_Click" />
                <MenuItem Header="Export _Selected Template" Click="ExportSelected_Click" />
                <Separator />
                <MenuItem Header="_Exit" Click="Exit_Click" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="200" MaxWidth="500" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="360" MinWidth="200" MaxWidth="500" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="8,8,0,8" CornerRadius="8" Background="{StaticResource TraeSurface}" BorderBrush="{StaticResource TraeBorder}" BorderThickness="1">
                <TabControl Margin="0" Background="Transparent">
                    <TabItem Header="连接" Height="36">
                        <ScrollViewer Padding="12">
                            <StackPanel>
                                <GroupBox Header="连接模式" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="rbActive" Content="主动模式" IsChecked="True" Margin="0,0,16,0" />
                                        <RadioButton x:Name="rbPassive" Content="被动模式" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="连接设置" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="IP地址:" />
                                            <TextBox Grid.Column="1" x:Name="txtIpAddress" Text="127.0.0.1" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="端口:" />
                                            <TextBox Grid.Column="1" x:Name="txtPort" Text="5000" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="设备ID:" />
                                            <TextBox Grid.Column="1" x:Name="txtDeviceId" Text="0" />
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="超时设置 (毫秒)" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Row="0" Grid.Column="0" Content="T3:" />
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtT3" Text="45000" />
                                        <Label Grid.Row="1" Grid.Column="0" Content="T5:" />
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtT5" Text="10000" />
                                        <Label Grid.Row="2" Grid.Column="0" Content="T6:" />
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtT6" Text="5000" />
                                        <Label Grid.Row="3" Grid.Column="0" Content="T7:" />
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtT7" Text="10000" />
                                    </Grid>
                                </GroupBox>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button x:Name="btnConnect" Content="连接" Width="140" Height="36" Click="Connect_Click" />
                                    <Button x:Name="btnDisconnect" Content="断开" Width="140" Height="36" Click="Disconnect_Click" IsEnabled="False" />
                                </StackPanel>

                                <GroupBox Header="连接状态" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="状态:" />
                                            <Label Grid.Column="1" x:Name="lblStatus" Content="未连接" />
                                            <Ellipse Grid.Column="2" x:Name="statusLed" Width="16" Height="16" Fill="#666666" />
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="模式:" />
                                            <Label Grid.Column="1" x:Name="lblMode" Content="-" />
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="对端:" />
                                            <Label Grid.Column="1" x:Name="lblPeer" Content="-" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="会话:" />
                                            <Label Grid.Column="1" x:Name="lblSession" Content="-" />
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="超时计时器">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="T3:" />
                                            <Label Grid.Column="1" x:Name="lblT3" Content="-" FontFamily="Consolas" />
                                            <Label Grid.Column="2" x:Name="lblT3Status" Content="空闲" Foreground="#4ec9b0" />
                                            <ProgressBar Grid.Column="3" x:Name="pbT3" Height="14" Margin="4,0,0,0" Maximum="100" Value="0" />
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="T5:" />
                                            <Label Grid.Column="1" x:Name="lblT5" Content="-" FontFamily="Consolas" />
                                            <Label Grid.Column="2" x:Name="lblT5Status" Content="空闲" Foreground="#4ec9b0" />
                                            <ProgressBar Grid.Column="3" x:Name="pbT5" Height="14" Margin="4,0,0,0" Maximum="100" Value="0" />
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="T7:" />
                                            <Label Grid.Column="1" x:Name="lblT7" Content="-" FontFamily="Consolas" />
                                            <Label Grid.Column="2" x:Name="lblT7Status" Content="空闲" Foreground="#4ec9b0" />
                                            <ProgressBar Grid.Column="3" x:Name="pbT7" Height="14" Margin="4,0,0,0" Maximum="100" Value="0" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="T8:" />
                                            <Label Grid.Column="1" x:Name="lblT8" Content="-" FontFamily="Consolas" />
                                            <Label Grid.Column="2" x:Name="lblT8Status" Content="空闲" Foreground="#4ec9b0" />
                                            <ProgressBar Grid.Column="3" x:Name="pbT8" Height="14" Margin="4,0,0,0" Maximum="100" Value="0" />
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="指令库" Height="36">
                        <ScrollViewer Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBox Grid.Row="0" x:Name="txtTemplateSearch" Margin="0,0,0,10" ToolTip="搜索模板" />

                                <TreeView Grid.Row="1" x:Name="treeTemplates" Margin="0,0,0,0" MouseRightButtonUp="treeTemplates_MouseRightButtonUp" PreviewKeyDown="treeTemplates_PreviewKeyDown" KeyDown="treeTemplates_KeyDown" AllowDrop="True" DragEnter="treeTemplates_DragEnter" DragOver="treeTemplates_DragOver" Drop="treeTemplates_Drop" PreviewMouseLeftButtonDown="treeTemplates_PreviewMouseLeftButtonDown" MouseMove="treeTemplates_MouseMove" PreviewMouseLeftButtonUp="treeTemplates_PreviewMouseLeftButtonUp">
                                    <TreeView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Send Message" Click="SendTemplateDirectly_Click" />
                                            <MenuItem Header="Edit Template" Click="EditTemplate_Click" />
                                            <Separator />
                                            <MenuItem Header="Copy Template" Click="CopyTemplate_Click" InputGestureText="Ctrl+C" />
                                            <MenuItem Header="Paste Template" Click="PasteTemplate_Click" InputGestureText="Ctrl+V" />
                                            <Separator />
                                            <MenuItem Header="Add Template" Click="AddTemplate_Click" />
                                            <MenuItem Header="Delete Template" Click="DeleteTemplate_Click" />
                                        </ContextMenu>
                                    </TreeView.ContextMenu>
                                </TreeView>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1" Background="{StaticResource TraeBorder}" Width="8" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <Border Grid.Column="2" Margin="0,8,0,8" CornerRadius="8" Background="{StaticResource TraeSurface}" BorderBrush="{StaticResource TraeBorder}" BorderThickness="1">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="4" Background="#f8f8f8" BorderBrush="{StaticResource TraeBorder}" BorderThickness="1" Margin="0,0,0,0">
                            <StackPanel Margin="8">
                                <Label Content="原始数据" FontWeight="SemiBold" Foreground="{StaticResource TraeTextSecondary}" Margin="0,0,0,4" />
                                <TextBox x:Name="txtRawData" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" FontSize="11" MinHeight="150" />
                            </StackPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" Background="{StaticResource TraeBorder}" Width="8" ResizeDirection="Columns" />

                        <Border Grid.Column="2" CornerRadius="4" Background="#f8f8f8" BorderBrush="{StaticResource TraeBorder}" BorderThickness="1" Margin="0,0,0,0">
                            <StackPanel Margin="8">
                                <Label Content="消息详情" FontWeight="SemiBold" Foreground="{StaticResource TraeTextSecondary}" Margin="0,0,0,4" />
                                <TextBox Grid.Row="0" x:Name="txtMessageDetail" AcceptsReturn="True" IsReadOnly="True" MinHeight="100" Margin="0,0,0,4" />
                                <TextBox x:Name="txtHexData" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" FontSize="11" MinHeight="40" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <GridSplitter Grid.Row="1" Background="{StaticResource TraeBorder}" Height="8" ResizeDirection="Rows" />

                    <Border Grid.Row="2" CornerRadius="4" Background="#f8f8f8" BorderBrush="{StaticResource TraeBorder}" BorderThickness="1">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0" x:Name="txtFilter" Margin="0,0,0,4" ToolTip="搜索日志" />
                            <RichTextBox Grid.Row="1" x:Name="txtLog" IsReadOnly="True" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="logCount" Text="0 条日志" Foreground="{StaticResource TraeTextDisabled}" Margin="4" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Background="{StaticResource TraeBorder}" Width="8" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <Border Grid.Column="4" Margin="0,8,8,8" CornerRadius="8" Background="{StaticResource TraeSurface}" BorderBrush="{StaticResource TraeBorder}" BorderThickness="1">
                <TabControl Margin="8" Background="Transparent">
                    <TabItem Header="模板详情">
                        <ScrollViewer Padding="4">
                            <StackPanel>
                        <GroupBox Header="模板详情" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="名称:" />
                                    <TextBox Grid.Column="1" x:Name="txtTemplateName" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="描述:" />
                                    <TextBox Grid.Column="1" x:Name="txtTemplateDesc" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="S:" />
                                    <TextBox Grid.Column="1" x:Name="txtTemplateStream" Text="1" />
                                    <Label Grid.Column="2" Content="Function:" />
                                    <TextBox Grid.Column="3" x:Name="txtTemplateFunction" Text="1" />
                                </Grid>
                                <CheckBox x:Name="chkTemplateAutoReply" Content="收到对应奇数 Function 时自动回复此模板" Margin="72,0,0,8" />
                                <Label Content="消息数据 (YAML格式):" Margin="0,4,0,2" />
                                <Grid>
                                    <controls:YamlEditor x:Name="txtTemplateSml" MinHeight="150" TextChanged="txtTemplateSml_TextChanged" PreviewKeyDownEvent="txtTemplateSml_PreviewKeyDown" />
                                    <ListBox x:Name="lstAutoComplete" Visibility="Collapsed" Background="White" BorderBrush="#007acc" 
                                             BorderThickness="1" SelectionMode="Single" MaxHeight="150" 
                                             HorizontalAlignment="Left" VerticalAlignment="Top"
                                             SelectionChanged="lstAutoComplete_SelectionChanged" MouseDoubleClick="lstAutoComplete_MouseDoubleClick"
                                             FontFamily="Consolas" FontSize="11"
                                             FocusVisualStyle="{x:Null}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="6,3" />
                                                <Setter Property="Foreground" Value="#333333" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="true">
                                                                    <Setter TargetName="Border" Property="Background" Value="#007acc" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </Trigger>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsSelected" Value="true" />
                                                                        <Condition Property="IsMouseOver" Value="true" />
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="Border" Property="Background" Value="#007acc" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </MultiTrigger>
                                                                <Trigger Property="IsMouseOver" Value="true">
                                                                    <Setter TargetName="Border" Property="Background" Value="#e6f2ff" />
                                                                    <Setter Property="Foreground" Value="#007acc" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Grid>
                                
                                <GroupBox Header="Item 快速构造" Margin="0,8,0,4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="72" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" x:Name="cmbItemType" SelectedIndex="0" ToolTip="SECS Item 类型">
                                                <ComboBoxItem Content="List" />
                                                <ComboBoxItem Content="ASCII" />
                                                <ComboBoxItem Content="Binary" />
                                                <ComboBoxItem Content="Boolean" />
                                                <ComboBoxItem Content="U1" />
                                                <ComboBoxItem Content="U2" />
                                                <ComboBoxItem Content="U4" />
                                                <ComboBoxItem Content="I1" />
                                                <ComboBoxItem Content="I2" />
                                                <ComboBoxItem Content="I4" />
                                                <ComboBoxItem Content="F4" />
                                                <ComboBoxItem Content="F8" />
                                            </ComboBox>
                                            <TextBox Grid.Column="1" x:Name="txtItemValues" ToolTip="多个值用逗号分隔；List 类型可留空" />
                                            <Button Grid.Column="2" Content="插入" Height="30" Click="InsertItem_Click" />
                                        </Grid>
                                        <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
                                            <Button Content="空 List" Width="72" Height="28" Click="InsertList_Click" />
                                            <Button Content="ACK=0" Width="72" Height="28" Click="InsertAck_Click" />
                                            <Button Content="S2F41" Width="72" Height="28" Click="InsertRemoteCommand_Click" />
                                            <Button Content="S6F11" Width="72" Height="28" Click="InsertEventReport_Click" />
                                            <Button Content="包成 List" Width="82" Height="28" Click="WrapSelectionList_Click" />
                                            <Button Content="校验" Width="58" Height="28" Click="ValidateTemplate_Click" />
                                            <Button Content="读 SML" Width="70" Height="28" Click="LoadSml_Click" />
                                        </WrapPanel>
                                    </Grid>
                                </GroupBox>

                                <Label Content="SML格式显示:" Margin="8,4,0,2" FontWeight="SemiBold" Foreground="{StaticResource TraeTextSecondary}" />
                                <TextBox x:Name="txtSmlPreview" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Background="#f5f5f5" MinHeight="100" />
                            </StackPanel>
                        </GroupBox>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <Button Content="保存" Width="80" Height="32" Click="SaveTemplate_Click" />
                            <Button Content="发送" Width="80" Height="32" Click="SendTemplate_Click" />
                        </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="模板源码">
                        <ScrollViewer Padding="4">
                        <GroupBox Header="模板源码" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" HorizontalAlignment="Right" Margin="0,0,0,6">
                                    <Button Content="重载" Width="64" Height="28" Click="ReloadTemplateSource_Click" />
                                    <Button Content="保存源码" Width="82" Height="28" Click="SaveTemplateSource_Click" />
                                    <Button Content="校验源码" Width="82" Height="28" Click="ValidateTemplateSource_Click" />
                                    <Button Content="定位模板" Width="82" Height="28" Click="LocateTemplateSource_Click" />
                                    <Button Content="刷新指令库" Width="92" Height="28" Click="ApplyTemplateSource_Click" />
                                </WrapPanel>
                                <TextBox Grid.Row="1" x:Name="txtSourceSearch" ToolTip="搜索源码" Margin="0,0,0,6" KeyDown="txtSourceSearch_KeyDown" />
                                <controls:YamlEditor Grid.Row="2" x:Name="txtTemplateSource" MinHeight="620" TextChanged="txtTemplateSource_TextChanged" />
                            </Grid>
                        </GroupBox>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <StatusBar Grid.Row="2" Height="24" Background="{StaticResource TraeSurfaceLight}">
            <StatusBarItem HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="bottomConnectionLed" Width="11" Height="11" Fill="#D13438" Stroke="#66000000" StrokeThickness="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="bottomConnectionText" Text="未连接" Foreground="{StaticResource TraeTextSecondary}" Margin="0,0,14,0" />
                    <TextBlock Text="指令库: " Foreground="{StaticResource TraeTextDisabled}" />
                    <TextBlock x:Name="txtTemplateFileName" Text="default.yaml" Foreground="{StaticResource TraePrimary}" FontWeight="Medium" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="SecsUtil v1.0" Foreground="{StaticResource TraeTextDisabled}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="statusText" Text="就绪" Foreground="{StaticResource TraeTextSecondary}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
